SOURCE_DB=./xjtlu_knowledge.db
RAG_DB=./rag_index.db
MEMORY_DB=./chat_memory.db

# provider: ollama or openai
CHAT_PROVIDER=ollama
EMBED_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
CHAT_MODEL=qwen2.5:7b-instruct

# OpenAI-compatible remote server, for example vLLM / Xinference / FastChat / LMDeploy.
# If your server exposes http://SERVER_IP:8000/v1/chat/completions, set OPENAI_BASE_URL=http://SERVER_IP:8000/v1
OPENAI_BASE_URL=http://SERVER_IP:8000/v1
OPENAI_API_KEY=EMPTY

TOP_K=6
SIMILARITY_THRESHOLD=0.35
ANSWER_MAX_CHARS=100

# Optional ROS2 voice bridge settings.
# The bridge subscribes to ROS_WAKE_TOPIC and ROS_AUDIO_TOPIC, and publishes answers to ROS_REPLY_TOPIC.
ROS_WAKE_TOPIC=/wake_word_event
ROS_AUDIO_TOPIC=/audio_msg
ROS_REPLY_TOPIC=/xjtlu_reply
ROS_REPLY_FORMAT=text
ROS_WAKE_WORD=你好小浦
ROS_WAKE_ACK_TEXT=我在
ROS_SESSION_PREFIX=ros
