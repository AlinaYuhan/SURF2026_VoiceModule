# Paths to existing projects. These values are overrideable so the workspace
# can be relocated into a release bundle.
WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SURF_ROOT="${SURF_ROOT:-${HOME}/SURF2026_VoiceModule-main}"
QWEN_ROOT="${QWEN_ROOT:-${HOME}/qwen_ros_node_edg_tts}"

# demo mode: listen means every /audio_msg is handled. wake means demo also
# applies its own wake-word filter after SURF ASR.
SURF_DEMO_MODE=listen
SURF_DEMO_WAKE_WORDS=

# Voice input source for integrated pipeline.
VOICE_AUDIO_SOURCE="${VOICE_AUDIO_SOURCE:-robot}"

# Low-latency SURF overrides. These are sourced before SURF's original
# default.env, so run_surf_voice_runtime.sh reapplies them after sourcing SURF.
SURF_DEMO_ASR_WINDOW_SEC="${SURF_DEMO_ASR_WINDOW_SEC:-8.0}"
SURF_DEMO_VAD_HOLDOFF_SEC="${SURF_DEMO_VAD_HOLDOFF_SEC:-4.0}"

# Wake word mode for SURF voice runtime.
VOICE_WAKE_WORD_LANG="${VOICE_WAKE_WORD_LANG:-zh}"

# Must stay 0 in this integrated setup, because SURF is the ASR publisher.
QWEN_AUTOSTART_ASR_BRIDGE="${QWEN_AUTOSTART_ASR_BRIDGE:-0}"

# Copied model runtime configuration.
DEMO_AUDIO_TOPIC="${DEMO_AUDIO_TOPIC:-/audio_msg}"
QWEN_PYTHON="${QWEN_PYTHON:-${HOME}/miniconda3/envs/qwen/bin/python}"
DEMO_SERVER_URL="${DEMO_SERVER_URL:-http://127.0.0.1:8000/infer}"
DEMO_REQUEST_TIMEOUT_SEC="${DEMO_REQUEST_TIMEOUT_SEC:-60}"
DEMO_WAKE_WORDS="${DEMO_WAKE_WORDS:-你好小浦,小浦}"
QWEN_MODEL_PATH="${QWEN_MODEL_PATH:-${HOME}/Qwen3.5-0.8B/model}"
DEMO_REPLY_BACKEND="rag"
QWEN_DASHSCOPE_MODEL="${QWEN_DASHSCOPE_MODEL:-qwen-plus}"
QWEN_DASHSCOPE_BASE_URL="${QWEN_DASHSCOPE_BASE_URL:-https://dashscope.aliyuncs.com/compatible-mode/v1}"
DEMO_RAG_SERVER_URL="${DEMO_RAG_SERVER_URL:-http://127.0.0.1:8010/chat}"
DEMO_SERVER_HOST="${DEMO_SERVER_HOST:-0.0.0.0}"
DEMO_SERVER_PORT="${DEMO_SERVER_PORT:-8000}"
DEMO_MAX_NEW_TOKENS="${DEMO_MAX_NEW_TOKENS:-50}"
DEMO_TEMPERATURE="${DEMO_TEMPERATURE:-0.3}"
DEMO_RUNTIME_DIR="${DEMO_RUNTIME_DIR:-${WORKSPACE_ROOT}/runtime}"

UNITREE_DOMAIN_ID="${UNITREE_DOMAIN_ID:-0}"
UNITREE_ENABLE="${UNITREE_ENABLE:-1}"
UNITREE_NETWORK_INTERFACE="${UNITREE_NETWORK_INTERFACE:-enp8s0}"
UNITREE_AUDIO_VOLUME="${UNITREE_AUDIO_VOLUME:-85}"

QWEN_ACTION_ENABLE="${QWEN_ACTION_ENABLE:-1}"
QWEN_ACTION_EXECUTE="${QWEN_ACTION_EXECUTE:-1}"
QWEN_ACTION_BACKEND="${QWEN_ACTION_BACKEND:-qwen}"
QWEN_ACTION_THRESHOLD="${QWEN_ACTION_THRESHOLD:-0.8}"
QWEN_ACTION_AUTO_RELEASE="${QWEN_ACTION_AUTO_RELEASE:-0}"
QWEN_ACTION_RELEASE_AFTER_SEC="${QWEN_ACTION_RELEASE_AFTER_SEC:-5}"
QWEN_ACTION_PYTHON="${QWEN_ACTION_PYTHON:-${HOME}/unitree_g1_action_classifier_package/.venv/bin/python}"
QWEN_ACTION_SCRIPT="${QWEN_ACTION_SCRIPT:-${HOME}/unitree_g1_action_classifier_package/arm_action_classifier/arm_action_classifier.py}"
QWEN_ACTION_RUNNER="${QWEN_ACTION_RUNNER:-${HOME}/unitree_g1_action_classifier_package/unitree_sdk2/build/bin/g1_arm_action_example}"

# SURF context topics consumed by the integrated demo node.
SURF_WAKE_TOPIC="${SURF_WAKE_TOPIC:-/wake_word_event}"
SURF_VAD_TOPIC="${SURF_VAD_TOPIC:-/vad_state}"
SURF_SPEAKER_TOPIC="${SURF_SPEAKER_TOPIC:-/speaker_id}"
SURF_DEMO_INCLUDE_SPEAKER_CONTEXT="${SURF_DEMO_INCLUDE_SPEAKER_CONTEXT:-1}"
SURF_DEMO_WRITE_CONTEXT_STATUS="${SURF_DEMO_WRITE_CONTEXT_STATUS:-1}"
SURF_DEMO_FILTER_BAD_ASR="${SURF_DEMO_FILTER_BAD_ASR:-1}"
SURF_DEMO_MIN_ASR_CHARS="${SURF_DEMO_MIN_ASR_CHARS:-2}"
SURF_DEMO_MIN_AUDIO_CONFIDENCE="${SURF_DEMO_MIN_AUDIO_CONFIDENCE:-0.55}"
SURF_DEMO_WAKE_ACK_ENABLE="${SURF_DEMO_WAKE_ACK_ENABLE:-1}"
SURF_DEMO_WAKE_ACK_TEXT="${SURF_DEMO_WAKE_ACK_TEXT:-我在}"
SURF_DEMO_WAKE_ACK_TEXT_ZH="${SURF_DEMO_WAKE_ACK_TEXT_ZH:-我在}"
SURF_DEMO_WAKE_ACK_TEXT_EN="${SURF_DEMO_WAKE_ACK_TEXT_EN:-here i am}"
SURF_DEMO_WAKE_ACK_COOLDOWN_SEC="${SURF_DEMO_WAKE_ACK_COOLDOWN_SEC:-1.0}"
SURF_DEMO_WAKE_ACK_ACTION_ENABLE="${SURF_DEMO_WAKE_ACK_ACTION_ENABLE:-1}"
SURF_DEMO_WAKE_ACK_ACTION_ID="${SURF_DEMO_WAKE_ACK_ACTION_ID:-25}"
SURF_DEMO_WAKE_ACK_ACTION_LABEL="${SURF_DEMO_WAKE_ACK_ACTION_LABEL:-面前挥手}"
SURF_DEMO_THINKING_ACK_ENABLE="${SURF_DEMO_THINKING_ACK_ENABLE:-1}"
SURF_DEMO_THINKING_ACK_TEXT="${SURF_DEMO_THINKING_ACK_TEXT:-收到}"
SURF_DEMO_WAKE_LISTEN_SEC="${SURF_DEMO_WAKE_LISTEN_SEC:-8.0}"
QWEN_ACTION_KEYWORD_FIRST="${QWEN_ACTION_KEYWORD_FIRST:-1}"

# RAG backend configuration. Used when DEMO_REPLY_BACKEND=rag.
RAG_SERVER_HOST="${RAG_SERVER_HOST:-127.0.0.1}"
RAG_SERVER_PORT="${RAG_SERVER_PORT:-8010}"
SOURCE_DB="${SOURCE_DB:-${WORKSPACE_ROOT}/xjtlu-rag-system/xjtlu_knowledge.db}"
RAG_DB="${RAG_DB:-${WORKSPACE_ROOT}/xjtlu-rag-system/rag_index.db}"
MEMORY_DB="${MEMORY_DB:-${WORKSPACE_ROOT}/runtime/xjtlu_chat_memory.db}"
CHAT_PROVIDER="openai"
EMBED_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_BIN="${OLLAMA_BIN:-${HOME}/.local/ollama/bin/ollama}"
OLLAMA_MODELS="${OLLAMA_MODELS:-${HOME}/.ollama/models}"
EMBED_MODEL="nomic-embed-text"
CHAT_MODEL="deepseek-v4-pro"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY="${OPENAI_API_KEY:-}"
TOP_K="${TOP_K:-6}"
SIMILARITY_THRESHOLD="${SIMILARITY_THRESHOLD:-0.35}"
ANSWER_MAX_CHARS="${ANSWER_MAX_CHARS:-100}"

DASHSCOPE_API_KEY="${DASHSCOPE_API_KEY:-}"
